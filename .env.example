# Supabase - Obtén estos valores desde: https://supabase.com/dashboard/project/_/settings/database
# Para DATABASE_URL: usa la URL de "Transaction" (puerto 6543) para Prisma en producción
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Para DIRECT_URL: usa la URL directa (puerto 5432) para migraciones
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Auth - Obtén estos valores desde: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"

# Para Server Actions y middleware (usa la SERVICE ROLE KEY - ¡NUNCA la expongas al cliente!)
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

