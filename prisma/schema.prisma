datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MESERO
  COCINA
}

enum OrderStatus {
  PENDIENTE
  PREPARANDO
  HECHO
  ENTREGADO
  PAGADO
  CANCELADO
}

enum TipoPedido {
  MESA
  LLEVAR
  DOMICILIO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

model Perfil {
  id             String       @id // UUID de Supabase Auth
  email          String       @unique
  nombre         String
  role           Role         @default(MESERO)
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  pedidos        Pedido[]     @relation("MeseroPedidos")
  cierresCaja    CierreCaja[]
}

model Categoria {
  id        String     @id @default(uuid())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id          String          @id @default(uuid())
  nombre      String
  precio      Decimal         @db.Decimal(10, 2)
  imagen      String?
  disponible  Boolean         @default(true)
  categoriaId String
  categoria   Categoria       @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  detalles    DetallePedido[]

  @@index([categoriaId])
}

model Pedido {
  id          String          @id @default(uuid())
  mesa        Int             @default(0)
  tipoPedido  TipoPedido      @default(MESA)
  cliente     String?
  telefono    String?
  direccion   String?
  notas       String?
  detalle     String?         // Texto plano de respaldo para webhooks/sync
  total       Decimal         @db.Decimal(10, 2)
  estado      OrderStatus     @default(PENDIENTE)

  // Auditoría
  creadoPorId String?
  creadoPor   Perfil?         @relation("MeseroPedidos", fields: [creadoPorId], references: [id], onDelete: SetNull)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       DetallePedido[]
  pagos       Pago[]

  @@index([estado])
  @@index([createdAt])
  @@index([mesa])
}

model DetallePedido {
  id             String    @id @default(uuid())
  pedidoId       String
  pedido         Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String?
  producto       Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  nombre         String
  precioUnitario Decimal   @db.Decimal(10, 2)
  cantidad       Int       @default(1)
  subtotal       Decimal   @db.Decimal(10, 2)
  notas          String?
  createdAt      DateTime  @default(now())

  @@index([pedidoId])
}

model Pago {
  id            String     @id @default(uuid())
  pedidoId      String
  pedido        Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodoPago    MetodoPago
  monto         Decimal    @db.Decimal(10, 2)
  montoRecibido Decimal?   @db.Decimal(10, 2)
  cambio        Decimal?   @db.Decimal(10, 2)
  referencia    String?
  createdAt     DateTime   @default(now())

  @@index([pedidoId])
}

model CierreCaja {
  id               String   @id @default(uuid())
  fecha            DateTime @default(now())
  responsableId    String?
  responsable      Perfil?  @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  baseInicial      Decimal  @default(0) @db.Decimal(10, 2)
  ventasEfectivo   Decimal  @default(0) @db.Decimal(10, 2)
  ventasTransf     Decimal  @default(0) @db.Decimal(10, 2)
  totalVentas      Decimal  @default(0) @db.Decimal(10, 2)
  retiros          Decimal  @default(0) @db.Decimal(10, 2)
  efectivoEsperado Decimal  @default(0) @db.Decimal(10, 2)
  efectivoReal     Decimal  @default(0) @db.Decimal(10, 2)
  diferencia       Decimal  @default(0) @db.Decimal(10, 2)
  totalPedidos     Int      @default(0)
  ticketPromedio   Decimal  @default(0) @db.Decimal(10, 2)
  observaciones    String?
  createdAt        DateTime @default(now())

  @@index([fecha])
}
