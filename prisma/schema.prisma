datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MESERO
  COCINA
}

enum OrderStatus {
  PENDIENTE
  PREPARANDO
  HECHO
  ENTREGADO
  PAGADO
  CANCELADO
}

model Perfil {
  id        String   @id // Vinculado al UUID de Supabase Auth
  email     String   @unique
  nombre    String
  role      Role     @default(MESERO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Categoria {
  id        String     @id @default(uuid())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id          String          @id @default(uuid())
  nombre      String
  precio      Float
  imagen      String?
  disponible  Boolean         @default(true)
  categoriaId String
  categoria   Categoria       @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  detalles    DetallePedido[]
}

model Pedido {
  id                String          @id @default(uuid())
  mesa              Int             @default(0)
  tipoPedido        String          @default("MESA") // MESA | LLEVAR | DOMICILIO
  cliente           String?
  telefono          String?
  direccion         String?
  notas             String?
  detalle           String          // Descripción textual (mantenida para sincronización en tiempo real)
  total             Float
  metodoPago        String?         // EFECTIVO | TRANSFERENCIA | DIVIDIDO
  pagoEfectivo      Float           @default(0)
  pagoTransferencia Float           @default(0)
  estado            OrderStatus     @default(PENDIENTE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items             DetallePedido[]
  pagos             Pago[]
}

model DetallePedido {
  id             String    @id @default(uuid())
  pedidoId       String
  pedido         Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String?
  producto       Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  nombre         String
  precioUnitario Float
  cantidad       Int       @default(1)
  subtotal       Float
  notas          String?
  createdAt      DateTime  @default(now())
}

model Pago {
  id            String   @id @default(uuid())
  pedidoId      String
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodoPago    String   // EFECTIVO | TRANSFERENCIA
  monto         Float
  montoRecibido Float?   // Efectivo recibido para cálculo de cambio
  cambio        Float?
  referencia    String?  // Referencia o comprobante
  createdAt     DateTime @default(now())
}

model CierreCaja {
  id               String   @id @default(uuid())
  fecha            DateTime @default(now())
  responsable      String
  baseInicial      Float    @default(0)
  ventasEfectivo   Float    @default(0)
  ventasTransf     Float    @default(0)
  totalVentas      Float    @default(0)
  retiros          Float    @default(0)
  efectivoEsperado Float    @default(0)
  efectivoReal     Float    @default(0)
  diferencia       Float    @default(0)
  totalPedidos     Int      @default(0)
  ticketPromedio   Float    @default(0)
  observaciones    String?
  createdAt        DateTime @default(now())
}
